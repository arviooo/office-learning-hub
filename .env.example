# Neon PostgreSQL Connection String (salin dari dashboard neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Kunci rahasia acak minimal 32 karakter untuk menandatangani cookie sesi login
AUTH_SECRET="ganti-dengan-teks-acak-panjang-minimal-32-karakter"
